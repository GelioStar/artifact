<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Typing Trainer</title>
  <meta http-equiv="Content-Security-Policy" content="default-src 'self' 'unsafe-inline' https://cdn.anychart.com https://cdnjs.cloudflare.com; script-src 'self' 'unsafe-inline' https://cdn.anychart.com https://cdnjs.cloudflare.com;">
  <link rel="stylesheet" href="styles/styles.css">
  <!-- AnyChart CDN for charts -->
  <script src="https://cdn.anychart.com/releases/8.12.0/js/anychart-base.min.js"></script>
  <script src="https://cdn.anychart.com/releases/8.12.0/js/anychart-ui.min.js"></script>
  <script src="https://cdn.anychart.com/releases/8.12.0/js/anychart-exports.min.js"></script>
</head>
<body>
  <div id="app" class="dark">
    <header>
      <h1>Typing Trainer</h1>
      <div class="controls">
        <select id="language">
          <option value="en">English</option>
          <option value="ru">Русский</option>
        </select>
        <label>Duration:
          <select id="duration"><option>15</option><option selected>60</option><option>120</option><option>180</option></select>
        </label>
        <label><input type="checkbox" id="punct"> Punctuation</label>
        <button id="startBtn">Start</button>
      </div>
    </header>

    <main>
      <section class="trainer">
        <div id="timer">60</div>
        <div id="passage" class="passage" aria-live="polite"></div>
        <textarea id="input" placeholder="Type here..." autofocus></textarea>
      </section>

      <section class="results" id="resultsPanel" hidden>
        <h2>Results</h2>
        <div id="chart" style="width:100%;height:360px;"></div>
        <div id="summary"></div>
        <button id="restart">Restart</button>
      </section>
    </main>
  </div>

  <script src="scripts/renderer.js" type="module"></script>
</body>
</html>
